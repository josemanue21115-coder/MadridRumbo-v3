# Añadir a .env.example y a tu .env real:
API_BASE_URL=http://127.0.0.1:8000 # Si se despliega el backend en render, esta es la URL del Web service.
# Orígenes del front / clientes web (separados por coma). Cambiad según el entorno.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8501,http://localhost:3000
API_KEY= # Si se despliega en Render, debe coincidir con la variable de entorno del Web Service.
RATE_LIMIT_PER_MINUTE=30
ASK_TIMEOUT_SECONDS=300
OPENAI_API_KEY=tu_clave_de_OpenAI
GEMINI_API_KEY=tu_clave_de_google_ai_studio
GOOGLE_ROUTES_API_KEY=
NOMINATIM_CONTACTO=
EMT_CLIENT_ID=
EMT_PASS_KEY=
DATABASE_URL=postgresql://madridrumbo:CAMBIAR_PASSWORD@localhost:5432/madridrumbo # Si se despliega en Render, utilizar la internal URL de la base de datos.
